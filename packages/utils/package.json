{
  "name": "@bridge-ui/utils",
  "version": "0.0.1",
  "description": "Shared utility functions for BridgeUI packages",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@bridge-ui/tsconfig": "workspace:*",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.3"
  }
}
