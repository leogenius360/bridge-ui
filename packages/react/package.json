{
  "name": "@bridge-ui/react",
  "version": "0.0.1",
  "description": "React components for BridgeUI — semantic, multi-framework, optional styling",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./button": {
      "import": "./dist/components/button.js",
      "types": "./dist/components/button.d.ts"
    },
    "./dialog": {
      "import": "./dist/components/dialog.js",
      "types": "./dist/components/dialog.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@bridge-ui/core": "workspace:*",
    "@bridge-ui/utils": "workspace:*"
  },
  "devDependencies": {
    "@bridge-ui/styles": "workspace:*",
    "@bridge-ui/tsconfig": "workspace:*",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.3"
  }
}
